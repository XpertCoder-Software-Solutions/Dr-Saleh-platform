# Base URL of the API, including the /api prefix.
# Leave as /api in development (Vite proxies it to VITE_DEV_BACKEND_URL).
# In production set the full URL, e.g. https://api.drsaleh.com/api
VITE_API_URL=/api

# Where the dev server proxies /api and /uploads to.
VITE_DEV_BACKEND_URL=http://localhost:3000
